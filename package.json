{
  "name": "star_vessel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "wrangler types >/dev/null && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "stars": "node tools/build-stars.mjs",
    "constellations": "NODE_USE_ENV_PROXY=1 node tools/build-constellations.mjs",
    "exoplanets": "node tools/build-exoplanets.mjs && NODE_USE_ENV_PROXY=1 node tools/build-exoplanets-nasa.mjs",
    "moons": "NODE_USE_ENV_PROXY=1 node tools/build-moons.mjs && NODE_USE_ENV_PROXY=1 node tools/build-moon-names.mjs",
    "asteroids": "NODE_USE_ENV_PROXY=1 node tools/build-asteroids.mjs",
    "satellites": "NODE_USE_ENV_PROXY=1 node tools/build-satellites.mjs",
    "clusters": "NODE_USE_ENV_PROXY=1 node tools/build-clusters.mjs",
    "compact": "NODE_USE_ENV_PROXY=1 node tools/build-compact.mjs",
    "cluster-members": "NODE_USE_ENV_PROXY=1 node tools/build-cluster-members.mjs",
    "comets": "NODE_USE_ENV_PROXY=1 node tools/build-comets.mjs",
    "spacecraft": "NODE_USE_ENV_PROXY=1 node tools/build-spacecraft.mjs",
    "nebulae": "NODE_USE_ENV_PROXY=1 node tools/build-nebulae.mjs",
    "galaxies": "NODE_USE_ENV_PROXY=1 node tools/build-galaxies.mjs",
    "gaia": "NODE_USE_ENV_PROXY=1 node tools/build-gaia.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "auth:schema": "node tools/gen-auth-schema.ts",
    "sim:ships": "node tools/sim-ships.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.17",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "better-auth": "^1.7.17",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^7.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
